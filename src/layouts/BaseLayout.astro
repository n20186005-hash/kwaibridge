---
import '../styles/global.css';
import Header from '../components/Header.astro';
import NoticeBanner from '../components/NoticeBanner.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, buildAlternates, htmlLangAttr, getI18n } from '../i18n/ui';
import { ogLocale, siteConfig, placeConfig, galleryConfig, absoluteUrl } from '../config';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const htmlLang = htmlLangAttr(lang);
const alts = buildAlternates(path);
const canonical = alts[lang] ?? alts.zh;
const { messages } = getI18n(Astro.url);
const attractionName = messages.header?.siteName ?? messages.footer?.siteName ?? messages.meta.title;

const heroImageAbsolute = absoluteUrl(placeConfig.heroImage);
const iconAbsolute = absoluteUrl(placeConfig.icon);
const locale = ogLocale[lang] ?? lang;

// 结构化数据的描述使用当前语言的 meta description，避免三语页面共用英文描述
const schemaDescription = messages.meta.description;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${siteConfig.baseUrl}/#attraction`,
  name: placeConfig.fullName,
  // 覆盖拼写变体：GSC 中 "river khwae bridge" 曝光最高，"river kwai bridge" 次之
  alternateName: [
    ...placeConfig.alternateNames,
    placeConfig.officialName,
    `${placeConfig.city} ${placeConfig.fullName}`,
  ],
  description: schemaDescription,
  inLanguage: htmlLang,
  url: canonical,
  mainEntityOfPage: canonical,
  image: [
    heroImageAbsolute,
    absoluteUrl(galleryConfig.file(1)),
    absoluteUrl(galleryConfig.file(10)),
    absoluteUrl(galleryConfig.file(15)),
  ],
  isAccessibleForFree: true,
  publicAccess: true,
  touristType: ['History travellers', 'Photographers', 'Families', 'Memorial visitors'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: placeConfig.streetAddress,
    addressLocality: placeConfig.city,
    addressRegion: placeConfig.province,
    postalCode: placeConfig.postalCode,
    addressCountry: placeConfig.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: placeConfig.latitude,
    longitude: placeConfig.longitude,
  },
  hasMap: placeConfig.mapsShareUrl,
  // 关联跨越的水体，帮助搜索引擎建立“桥—河—城市”的地理实体关系
  containedInPlace: {
    '@type': 'Place',
    name: placeConfig.city,
    address: {
      '@type': 'PostalAddress',
      addressLocality: placeConfig.city,
      addressRegion: placeConfig.province,
      addressCountry: placeConfig.countryCode,
    },
  },
  isPartOf: {
    '@type': 'LandmarksOrHistoricalBuildings',
    name: `${placeConfig.fullName} – Burma–Thailand Railway`,
    url: placeConfig.govtTourismUrl,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59',
    },
  ],
  offers: [
    {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'THB',
      url: canonical,
      description: `Free public access to ${placeConfig.fullName}.`,
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: placeConfig.ratingValue,
    reviewCount: placeConfig.reviewCount,
    bestRating: '5',
    worstRating: '1',
  },
  sameAs: [
    placeConfig.mapsShareUrl,
    placeConfig.govtTourismUrl,
    placeConfig.provinceUrl,
  ],
};

const breadcrumbLd = (() => {
  const bc = messages.breadcrumb;
  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: bc.home, item: `${siteConfig.baseUrl}/${lang}/` },
      { '@type': 'ListItem', position: 2, name: placeConfig.country, item: placeConfig.govtTourismUrl },
      { '@type': 'ListItem', position: 3, name: bc.region, item: `${siteConfig.baseUrl}/${lang}/#overview` },
      { '@type': 'ListItem', position: 4, name: bc.city, item: `${siteConfig.baseUrl}/${lang}/#transport` },
      { '@type': 'ListItem', position: 5, name: bc.current, item: canonical },
    ],
  };
})();

const placeLd = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  '@id': `${siteConfig.baseUrl}/#place`,
  name: placeConfig.fullName,
  alternateName: placeConfig.localName,
  address: {
    '@type': 'PostalAddress',
    streetAddress: placeConfig.streetAddress,
    addressLocality: placeConfig.city,
    addressRegion: placeConfig.province,
    postalCode: placeConfig.postalCode,
    addressCountry: placeConfig.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: placeConfig.latitude,
    longitude: placeConfig.longitude,
  },
  hasMap: placeConfig.mapsShareUrl,
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google tag (gtag.js) — GA4 -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${placeConfig.gaMeasurementId}`}></script>
    <script is:inline set:html={`window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '${placeConfig.gaMeasurementId}');`}></script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- 首屏大图以 CSS background 呈现，浏览器无法提前发现，需显式预加载以改善移动端 LCP -->
    <link rel="preload" as="image" href={heroImageAbsolute} fetchpriority="high" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh" href={alts.zh} />
    <link rel="alternate" hreflang="en" href={alts.en} />
    <link rel="alternate" hreflang="th" href={alts.th} />
    <link rel="alternate" hreflang="x-default" href={alts.xDefault} />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#c96a1d" />
    <meta name="application-name" content={placeConfig.fullName} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={placeConfig.fullName} />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icon-192.png" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={placeConfig.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={heroImageAbsolute} />
    <meta property="og:image:secure_url" content={heroImageAbsolute} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={`${placeConfig.fullName} in ${placeConfig.city}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={heroImageAbsolute} />
    <meta name="twitter:image:alt" content={`${placeConfig.fullName} in ${placeConfig.city}`} />

    {placeConfig.adsensePublisherId && (
      <>
        <meta name="google-adsense-account" content={placeConfig.adsensePublisherId} />
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${placeConfig.adsensePublisherId}`}
          crossorigin="anonymous"></script>
      </>
    )}

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(placeLd)}></script>

    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <Header />
    <NoticeBanner />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
