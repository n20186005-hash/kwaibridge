---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const f = messages.facilities;
const items = f.items ?? [];

const groups = [
  { id: 'onSite', icon: '📍' },
  { id: 'walk', icon: '🚶' },
  { id: 'town', icon: '🏙️' },
];
---

<section id="facilities" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{f.title}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{f.subtitle}</p>
    </div>

    <div class="flex flex-wrap justify-center gap-3 mb-4">
      {groups.map((group) => (
        <span
          class="text-xs px-3 py-1.5 rounded-full border flex items-center gap-1.5"
          style="background: var(--card-bg); border-color: var(--border-color); color: var(--text-secondary);"
        >
          <span aria-hidden="true">{group.icon}</span>
          {f.legend[group.id]}
        </span>
      ))}
    </div>

    <p
      class="max-w-3xl mx-auto text-center text-xs leading-relaxed mb-10 px-4 py-3 rounded-xl border"
      style="background: color-mix(in srgb, var(--accent) 8%, transparent); border-color: color-mix(in srgb, var(--accent) 30%, transparent); color: var(--text-secondary);"
    >
      {f.neutralNote}
    </p>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <article
          class="rounded-2xl border p-5 flex gap-4"
          style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);"
        >
          <span class="text-2xl leading-none shrink-0" aria-hidden="true">{item.icon}</span>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2 mb-1.5">
              <h3 class="font-semibold" style="color: var(--text-primary);">{item.name}</h3>
              <span
                class="text-[11px] px-2 py-0.5 rounded-full border shrink-0"
                style="background: var(--tag-bg); border-color: var(--border-color); color: var(--tag-text);"
              >
                {f.legend[item.where] ?? item.where}
              </span>
            </div>
            <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{item.note}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
