---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const sp = messages.areaGuide;
const items = sp.items ?? [];
const { embedded = false } = Astro.props;
const Wrapper = embedded ? 'div' : 'section';
const Heading = embedded ? 'h3' : 'h2';
const wrapperClass = embedded ? 'pt-4' : 'section-padding';
const wrapperStyle = embedded ? '' : 'background: var(--bg-secondary);';
const innerClass = embedded ? '' : 'max-w-5xl mx-auto px-4';
---

<Wrapper id="plaques" class={wrapperClass} style={wrapperStyle}>
  <div class={innerClass}>
    <div class="max-w-3xl mx-auto text-center mb-10">
      <Heading class={`font-display ${embedded ? 'text-2xl sm:text-3xl' : 'text-3xl sm:text-4xl'} font-semibold mb-3`} style="color: var(--text-primary);">{sp.title}</Heading>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{sp.subtitle}</p>
      <p class="text-sm mt-3" style="color: var(--text-tertiary);">{sp.intro}</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {items.map((it) => (
        <article
          class="rounded-2xl border p-5 h-full"
          style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);"
        >
          <div class="flex flex-wrap items-center gap-2.5 mb-2.5">
            {it.badge && (
              <span class="text-[11px] uppercase tracking-[0.14em] font-semibold px-2 py-0.5 rounded-full border" style="border-color: var(--border-color); color: var(--accent);">{it.badge}</span>
            )}
            <h4 class="font-semibold text-base" style="color: var(--text-primary);">{it.title}</h4>
          </div>
          {it.location && (
            <p class="text-xs mb-2.5" style="color: var(--text-muted);">{sp.locationLabel}: {it.location}</p>
          )}
          <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{it.body}</p>
        </article>
      ))}
    </div>
  </div>
</Wrapper>
