---
import { getI18n } from '../i18n/ui';
const { lang, messages } = getI18n(Astro.url);
const f = messages.footer;
const rights = lang === 'th'
  ? `© 2026 ${f.siteName} · สงวนลิขสิทธิ์`
  : lang === 'zh'
    ? `© 2026 ${f.siteName} · 版權所有。`
    : `© 2026 ${f.siteName} · All rights reserved.`;
const independence = lang === 'th'
  ? 'เว็บไซต์นี้เป็นโครงการข้อมูลการท่องเที่ยวอิสระ ไม่มีความเกี่ยวข้องกับหน่วยงานรัฐบาลหรือองค์กรทางการใด ๆ'
  : lang === 'zh'
    ? '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。'
    : 'This website is an independent tourism information project. We are not affiliated with any government agency or official organization.';
---

<footer class="section-padding" style="background: var(--bg-tertiary); border-top: 1px solid var(--border-color);">
  <div class="max-w-6xl mx-auto px-4 text-sm leading-relaxed" style="color: var(--text-secondary);">
    <p>{rights}</p>
    <p class="mt-3">{independence}</p>
  </div>
</footer>
