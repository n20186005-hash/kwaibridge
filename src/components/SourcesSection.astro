---
import { getI18n } from '../i18n/ui';
const { lang, messages } = getI18n(Astro.url);
const s = messages.sources ?? {};
const title = lang === 'zh' ? '信息来源和参考文献' : lang === 'th' ? 'แหล่งข้อมูลและเอกสารอ้างอิง' : 'Information Sources and References';
const caption = lang === 'zh'
  ? '查看桂河大桥历史、地点、评分、交通及天气资料的公开来源，并了解图片版权与资料核实方式。'
  : lang === 'th'
    ? 'ดูแหล่งอ้างอิงสาธารณะสำหรับประวัติ ที่ตั้ง รีวิว การเดินทาง และอากาศ พร้อมข้อมูลลิขสิทธิ์ภาพ'
    : 'Explore the public references behind the bridge history, location, reviews, rail and weather information, including image credits.';
const action = lang === 'zh' ? '查看完整来源与参考文献' : lang === 'th' ? 'อ่านแหล่งข้อมูลและเอกสารอ้างอิงทั้งหมด' : 'Read all sources and references';
---

<section id="sources" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-4" style="color: var(--text-primary);">{title}</h2>
    <p class="text-base sm:text-lg leading-relaxed mb-6" style="color: var(--text-secondary);">{caption}</p>
    <a href={`/${lang}/sources/`} class="inline-flex px-6 py-3 rounded-full text-white font-semibold" style="background: var(--accent);">{action} ↗</a>
  </div>
</section>
