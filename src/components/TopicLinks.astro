---
import { getI18n } from '../i18n/ui';
import { topics, type TopicLang } from '../i18n/topics';

const { lang } = getI18n(Astro.url);
const safeLang = lang as TopicLang;

const labels: Record<TopicLang, { heading: string; sub: string }> = {
  en: { heading: 'Guides & deeper reads', sub: 'Plan your River Kwai Bridge visit with practical routes, the stories behind the railway and tips for exploring Kanchanaburi.' },
  th: { heading: 'คู่มือและบทความเพิ่มเติม', sub: 'วางแผนเที่ยวสะพานข้ามแม่น้ำแควให้ครบ ทั้งเส้นทางเดินทาง เรื่องราวทางรถไฟ และจุดน่าแวะในกาญจนบุรี' },
  zh: { heading: '专题与延伸阅读', sub: '从桂河大桥的战争历史，到曼谷出发的交通路线与北碧府周边玩法，找到适合你的下一站。' },
};

const cards = topics.map((t) => ({
  href: `/${lang}/${t.slug}/`,
  title: t.h1[safeLang],
  desc: t.description[safeLang],
}));
---

<section class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-2 text-center" style="color: var(--text-primary);">{labels[safeLang].heading}</h2>
    <p class="text-center text-base sm:text-lg mb-8" style="color: var(--text-secondary);">{labels[safeLang].sub}</p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {cards.map((c) => (
        <a href={c.href} class="rounded-2xl border p-5 block hover:opacity-80" style="background: var(--card-bg); border-color: var(--border-color);">
          <p class="font-semibold text-base mb-1" style="color: var(--text-primary);">{c.title}</p>
          <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{c.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>
