---
import { getI18n } from '../i18n/ui';
const { messages, lang } = getI18n(Astro.url);
const tt = messages.trainTracker;
---

{tt && (
  <div class="max-w-4xl mx-auto mt-10 rounded-2xl border p-6 sm:p-8" style="background: color-mix(in srgb, var(--bg-tertiary) 50%, var(--card-bg)); border-color: var(--border-color); box-shadow: var(--card-shadow);">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-2xl">⏱️</span>
      <h3 class="font-display text-xl sm:text-2xl font-semibold" style="color: var(--text-primary);">{tt.title}</h3>
    </div>
    <p class="text-base leading-relaxed mb-6" style="color: var(--text-secondary);">{tt.description}</p>
    
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm whitespace-nowrap">
        <thead>
          <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted);">
            <th class="py-3 px-4 font-medium uppercase tracking-wider">{tt.colTrain}</th>
            <th class="py-3 px-4 font-medium uppercase tracking-wider">{tt.colRoute}</th>
            <th class="py-3 px-4 font-medium uppercase tracking-wider">{tt.colTime}</th>
          </tr>
        </thead>
        <tbody style="color: var(--text-primary);">
          {tt.schedules.map((row: any) => (
            <tr style="border-bottom: 1px solid var(--border-color);">
              <td class="py-3 px-4 font-semibold">{row.train}</td>
              <td class="py-3 px-4" style="color: var(--text-secondary);">{row.route}</td>
              <td class="py-3 px-4 font-medium" style="color: var(--accent);">{row.time}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-5 p-4 rounded-xl" style="background: color-mix(in srgb, var(--accent) 10%, transparent);">
      <p class="text-sm font-semibold" style="color: var(--accent);">⚠️ {tt.warning}</p>
    </div>
  </div>
)}
