---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const s = messages.seasonStrategy;
const rows = s.rows ?? [];

const levelStyle: Record<string, string> = {
  best: 'background: rgba(34,150,94,0.14); color: #1f7a4d; border-color: rgba(34,150,94,0.35);',
  good: 'background: rgba(91,124,153,0.16); color: #456276; border-color: rgba(91,124,153,0.38);',
  caution: 'background: rgba(214,148,26,0.16); color: #9a6712; border-color: rgba(214,148,26,0.38);',
};

const blocks = [
  { key: 'weather', icon: '🌡️' },
  { key: 'water', icon: '🌊' },
  { key: 'wildlife', icon: '🦜' },
  { key: 'crowds', icon: '👥' },
];
---

<section id="seasons" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{s.title}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{s.subtitle}</p>
    </div>

    <p class="max-w-3xl mx-auto text-center text-sm leading-relaxed mb-10" style="color: var(--text-secondary);">
      {s.intro}
    </p>

    <div class="grid gap-5 lg:grid-cols-3">
      {rows.map((row) => (
        <article
          class="rounded-3xl border p-6 flex flex-col"
          style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);"
        >
          <div class="flex items-start justify-between gap-3 mb-1">
            <div class="flex items-center gap-3">
              <span class="text-3xl leading-none" aria-hidden="true">{row.icon}</span>
              <div>
                <h3 class="font-display text-xl font-semibold leading-tight" style="color: var(--text-primary);">{row.name}</h3>
                <p class="text-xs uppercase tracking-[0.16em] mt-0.5" style="color: var(--text-muted);">{row.months}</p>
              </div>
            </div>
            <span class="text-[11px] px-2.5 py-1 rounded-full border shrink-0 font-semibold" style={levelStyle[row.level]}>
              {s.levels[row.level] ?? row.level}
            </span>
          </div>

          <div class="mt-5 space-y-4 text-sm flex-1">
            {blocks.map((block) => (
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.14em] mb-1.5 flex items-center gap-1.5" style="color: var(--text-muted);">
                  <span aria-hidden="true">{block.icon}</span>
                  {s.columns[block.key]}
                </p>
                <p class="leading-relaxed" style="color: var(--text-secondary);">{row[block.key]}</p>
              </div>
            ))}
          </div>

          <div class="mt-5 pt-4 border-t" style="border-color: var(--border-color);">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] mb-1.5" style="color: var(--accent);">
              {s.columns.verdict}
            </p>
            <p class="text-sm leading-relaxed" style="color: var(--text-primary);">{row.verdict}</p>
          </div>
        </article>
      ))}
    </div>

    <p class="max-w-4xl mx-auto mt-8 text-xs leading-relaxed" style="color: var(--text-muted);">{s.note}</p>
  </div>
</section>
