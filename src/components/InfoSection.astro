---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const t = messages.knowledge;
const sections = t.sections;
const dyk = t.didYouKnow;
const { embedded = false } = Astro.props;
---

{embedded ? (
  <div>
    <div class="space-y-8 relative before:absolute before:inset-0 before:ml-5 md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-[var(--border-color)] before:to-transparent">
      {sections.map((section, index) => (
        <div class={`relative flex flex-col md:flex-row gap-6 items-start md:items-center ${index % 2 !== 0 ? 'md:flex-row-reverse' : ''} group`}>
          <!-- Timeline marker -->
          <div class="flex items-center justify-center w-auto px-4 h-10 rounded-full border-4 border-[var(--bg-primary)] bg-[var(--accent)] text-white font-bold text-sm shrink-0 shadow-sm relative z-10 mx-0 md:mx-auto">
            {section.year}
          </div>
          
          <div class="flex-1 w-full bg-white/5 p-6 md:p-8 rounded-2xl border border-white/10 shadow-sm">
            <h3 class="font-display text-2xl font-semibold mb-3" style="color: var(--text-primary);">{section.title}</h3>
            <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{section.content}</p>
          </div>
          <div class="hidden md:block flex-1 w-full"></div>
        </div>
      ))}
    </div>

    {dyk && (
      <div class="mt-16 rounded-2xl p-7 border flex flex-col sm:flex-row gap-5 items-start relative overflow-hidden" style="background: color-mix(in srgb, var(--accent) 10%, var(--bg-tertiary)); border-color: color-mix(in srgb, var(--accent) 30%, var(--border-color)); box-shadow: var(--card-shadow);">
        <div class="absolute inset-x-0 top-0 h-1 bg-[var(--accent)]"></div>
        <div class="flex items-center justify-center w-12 h-12 rounded-full shrink-0" style="background: color-mix(in srgb, var(--accent) 20%, transparent); color: var(--accent);">
          <span class="text-2xl" aria-hidden="true">💡</span>
        </div>
        <div>
          <h3 class="font-semibold text-xl mb-3" style="color: var(--text-primary);">{dyk.title}</h3>
          <p class="text-base leading-relaxed" style="color: var(--text-secondary);">{dyk.text}</p>
        </div>
      </div>
    )}
  </div>
) : (
  <section id="history" class="section-padding" style="background: var(--bg-primary);">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-6 text-center" style="color: var(--text-primary);">{t.title}</h2>
      <div class="w-12 h-0.5 mb-12 mx-auto" style="background: var(--accent);"></div>

      <div class="space-y-8 relative before:absolute before:inset-0 before:ml-5 md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-[var(--border-color)] before:to-transparent">
        {sections.map((section, index) => (
          <div class={`relative flex flex-col md:flex-row gap-6 items-start md:items-center ${index % 2 !== 0 ? 'md:flex-row-reverse' : ''} group`}>
            <!-- Timeline marker -->
            <div class="flex items-center justify-center w-auto px-4 h-10 rounded-full border-4 border-[var(--bg-primary)] bg-[var(--accent)] text-white font-bold text-sm shrink-0 shadow-sm relative z-10 mx-0 md:mx-auto">
              {section.year}
            </div>
            
            <div class="flex-1 w-full bg-white/5 p-6 md:p-8 rounded-2xl border border-white/10 shadow-sm">
              <h3 class="font-display text-2xl font-semibold mb-3" style="color: var(--text-primary);">{section.title}</h3>
              <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{section.content}</p>
            </div>
            <div class="hidden md:block flex-1 w-full"></div>
          </div>
        ))}
      </div>

      {dyk && (
        <div class="mt-16 rounded-2xl p-7 border flex flex-col sm:flex-row gap-5 items-start relative overflow-hidden" style="background: color-mix(in srgb, var(--accent) 10%, var(--bg-tertiary)); border-color: color-mix(in srgb, var(--accent) 30%, var(--border-color)); box-shadow: var(--card-shadow);">
          <div class="absolute inset-x-0 top-0 h-1 bg-[var(--accent)]"></div>
          <div class="flex items-center justify-center w-12 h-12 rounded-full shrink-0" style="background: color-mix(in srgb, var(--accent) 20%, transparent); color: var(--accent);">
            <span class="text-2xl" aria-hidden="true">💡</span>
          </div>
          <div>
            <h3 class="font-semibold text-xl mb-3" style="color: var(--text-primary);">{dyk.title}</h3>
            <p class="text-base leading-relaxed" style="color: var(--text-secondary);">{dyk.text}</p>
          </div>
        </div>
      )}
    </div>
  </section>
)}
